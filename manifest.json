{
  "manifest_version": 3,
  "name": "Lightweight Tabs Unloader",
  "version": "1.0.0",
  "description": "Unloads background tabs from memory after they sit unused for a set time. Nothing else.",
  "author": "Labinator",
  "developer": {
    "name": "Labinator",
    "url": "https://labinator.com/"
  },
  "homepage_url": "https://github.com/LabinatorSolutions/lightweight-tabs-unloader",
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "permissions": ["alarms", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lightweight-tabs-unloader@labinator.com",
      "strict_min_version": "159.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
